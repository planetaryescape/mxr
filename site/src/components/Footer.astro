---
import Default from '@astrojs/starlight/components/Footer.astro';

const repo = 'https://github.com/planetaryescape/mxr';

const links = [
  { label: 'Privacy', href: '/privacy/' },
  { label: 'Terms', href: '/terms/' },
  { label: 'Security and privacy', href: '/guides/security-and-privacy/' },
  { label: 'GitHub', href: repo },
];
---

<Default />

<div class="site-footer">
  <nav class="site-footer-links" aria-label="Legal and project">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <p class="site-footer-license">
    <a href={`${repo}/blob/main/LICENSE-MIT`}>MIT</a> OR
    <a href={`${repo}/blob/main/LICENSE-APACHE`}>Apache-2.0</a>, at your option.
  </p>
</div>

<style>
  .site-footer {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.65rem 2rem;
    font-family: var(--font-mono);
    font-variation-settings: var(--rec-meta);
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    color: var(--paper-mute);
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  .site-footer-license {
    margin: 0;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .site-footer a:hover {
    color: var(--signal);
    border-bottom-color: currentColor;
  }

  .site-footer a:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 4px;
    color: var(--signal);
  }
</style>
