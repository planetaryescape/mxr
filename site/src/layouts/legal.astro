---
const { frontmatter } = Astro.props;
---
<!doctype html>
<!-- Legal pages have no theme toggle. Keep their code blocks on the dark syntax theme. -->
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#071522" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f4f9fc" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <title>{frontmatter.title} - mxr</title>
  <style is:global>
    /* Legal pages render outside Starlight and need their own palette. */
    :root {
      color-scheme: dark light;

      --paper: #f4f9fc;
      --ink: #071522;
      --rule: #294963;
      --signal: #57d5ff;

      /* Expressive Code reads its frame colours from Starlight variables. */
      --sl-color-black: #071522;
      --sl-color-gray-5: #587088;
      --sl-color-gray-6: #0d2234;
      --sl-color-gray-7: #132c42;
      --sl-color-text: #f4f9fc;
      --sl-color-accent: #57d5ff;
      --sl-color-accent-high: #bfefff;
    }

    @media (prefers-color-scheme: light) {
      :root {
        --paper: #10263b;
        --ink: #f4f9fc;
        --rule: #b9cedc;
        --signal: #006f93;
      }
    }

    body {
      margin: 0;
      background: var(--ink);
      color: var(--paper);
      font-family: system-ui, sans-serif;
      line-height: 1.6;
    }

    main {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem clamp(1rem, 4vw, 2rem);
    }

    a { color: var(--signal); }

    .skip-link {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .skip-link:focus,
    .skip-link:focus-visible {
      position: fixed;
      top: 1rem;
      left: 1rem;
      z-index: 10;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0.6rem 1rem;
      clip-path: none;
      background: var(--paper);
      color: var(--ink);
      outline: 2px solid var(--signal);
      outline-offset: 2px;
    }

    /* Long paths and scopes must wrap on narrow screens. */
    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid var(--rule);
      padding: 0.4rem 0.6rem;
      text-align: left;
      vertical-align: top;
      overflow-wrap: anywhere;
    }
  </style>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<main id="main">
  <h1>{frontmatter.title}</h1>
  <slot />
  <p><a href="/">Back to docs</a></p>
</main>
</body>
</html>
