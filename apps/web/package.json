{
  "name": "mxr-web",
  "version": "0.5.10",
  "private": true,
  "description": "Web interface for the mxr terminal email client. Connects to the daemon HTTP bridge.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ./.oxlintrc.json --disable-nested-config --react-plugin --vitest-plugin --deny-warnings src && node ./scripts/check-motion.mjs && node ./scripts/check-ai-marks.mjs && node ./scripts/check-type-scale.mjs && node ./scripts/check-shape.mjs && node ./scripts/check-frames.mjs && node ./scripts/gen-themes.mjs --check",
    "lint:fix": "oxlint -c ./.oxlintrc.json --disable-nested-config --react-plugin --vitest-plugin --fix src",
    "format": "oxfmt -c ./.oxfmt.json --write \"src/**/*.{ts,tsx,css}\" \"!src/routeTree.gen.ts\" \"scripts/**/*.mjs\"",
    "format:check": "oxfmt -c ./.oxfmt.json --check \"src/**/*.{ts,tsx,css}\" \"!src/routeTree.gen.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "node ./scripts/gen-bridge-types.mjs",
    "gen:themes": "node ./scripts/gen-themes.mjs",
    "pree2e": "node ./scripts/e2e-owned-processes.mjs",
    "e2e": "playwright test",
    "pree2e:engine": "node ./scripts/e2e-owned-processes.mjs",
    "e2e:engine": "playwright test --grep \"\\s(navigation|keyboard-help|keyboard-navigation|compose-send|reader|accessibility|messages|todo|updates|archive|now|search|offline-banner|onboarding-redirect|smoke|snooze|controls)\\.spec|design-gate\\.spec\\.ts.*midnight theme\"",
    "pree2e:webkit": "node ./scripts/e2e-owned-processes.mjs",
    "e2e:webkit": "MXR_E2E_WEBKIT=1 playwright test --project=webkit",
    "e2e:webkit:engine": "MXR_E2E_WEBKIT=1 playwright test --project=webkit --grep \"\\s(navigation|keyboard-help|keyboard-navigation|compose-send|reader|accessibility|messages|todo|updates|archive|now|search|offline-banner|onboarding-redirect|smoke|snooze|controls)\\.spec|design-gate\\.spec\\.ts.*midnight theme\"",
    "pree2e:perf": "node ./scripts/e2e-owned-processes.mjs",
    "e2e:perf": "playwright test -c playwright.perf.config.ts",
    "analyze": "ANALYZE=1 vite build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@codemirror/lang-markdown": "*",
    "@codemirror/state": "*",
    "@codemirror/view": "*",
    "@fontsource-variable/recursive": "5.3.0",
    "@planetaryescape/reader": "github:planetaryescape/reader#v0.1.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "*",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "*",
    "@radix-ui/react-dropdown-menu": "*",
    "@radix-ui/react-label": "*",
    "@radix-ui/react-popover": "*",
    "@radix-ui/react-scroll-area": "*",
    "@radix-ui/react-select": "*",
    "@radix-ui/react-separator": "*",
    "@radix-ui/react-slot": "*",
    "@radix-ui/react-switch": "*",
    "@radix-ui/react-tabs": "*",
    "@radix-ui/react-toggle": "*",
    "@radix-ui/react-toggle-group": "*",
    "@radix-ui/react-tooltip": "*",
    "@replit/codemirror-vim": "*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "*",
    "@tanstack/react-query-devtools": "*",
    "@tanstack/react-router": "*",
    "@tanstack/react-virtual": "*",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "*",
    "codemirror": "*",
    "dompurify": "^3.4.1",
    "email-addresses": "^5.0.0",
    "linkifyjs": "^4.3.2",
    "lucide-react": "^0.577.0",
    "marked": "18.0.14",
    "openapi-fetch": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "*",
    "react-resizable-panels": "^4.7.4",
    "sonner": "*",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tinykeys": "*",
    "tw-animate-css": "^1.4.0",
    "zustand": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "*",
    "@tanstack/react-router-devtools": "*",
    "@tanstack/router-plugin": "*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/culori": "4.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "culori": "4.0.2",
    "jsdom": "^27.2.0",
    "msw": "^2.12.14",
    "openapi-typescript": "^7.4.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "rollup-plugin-visualizer": "*",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  }
}
