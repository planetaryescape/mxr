    "bearer": {
      "bearerFormat": "opaque",
      "description": "Token from the `bridge-token` file in the active profile's config directory, or from `[bridge].token_path` / `MXR_BRIDGE_TOKEN_PATH` when either is set. Send via `Authorization: Bearer <token>` header. Browser WebSocket clients can use the `Sec-WebSocket-Protocol: bearer, <token>` subprotocol. The `?token=<token>` query string is accepted only by `/api/v1/events` for command-line WebSocket fallback.",
      "scheme": "bearer",
      "type": "http"
    }
  }
