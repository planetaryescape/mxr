{
  "name": "mxr-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate-cli-reference.mjs && bash scripts/dump-openapi-spec.sh",
    "generate:social": "node scripts/generate-social-images.mjs",
    "test": "node --test scripts/search-envelope-rule.test.mjs",
    "validate": "node scripts/validate-docs.mjs",
    "postbuild": "node scripts/generate-llms-txt.mjs",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && npm test && npm run validate && astro build && node scripts/generate-llms-txt.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.3",
    "@fontsource-variable/recursive": "5.3.0",
    "@scalar/api-reference": "^1.57.5",
    "astro": "7.1.3",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "@astrojs/sitemap": "3.7.2"
  }
}
