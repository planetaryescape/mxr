---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'API Explorer',
    description: 'Interactive reference for the mxr HTTP bridge. Try requests against your local daemon at http://127.0.0.1:42829.',
    template: 'splash',
    pagefind: false,
  }}
>
  <p>
    The mxr daemon serves an OpenAPI 3.1 spec at <code>/api/v1/openapi.json</code> when
    <code>[bridge]&nbsp;enabled&nbsp;=&nbsp;true</code> in your config (default). The explorer below
    is rendered from the spec generated during this site's build.
  </p>

  <p>
    To try requests, start the daemon (<code>mxr</code> or <code>mxr daemon</code>), grab your
    bearer token from <code>~/.config/mxr/bridge-token</code>, and click <strong>Authorize</strong>
    in the explorer.
  </p>

  <p>
    If the embedded explorer does not load, open the raw spec at
    <a href="/openapi.json"><code>/openapi.json</code></a>.
  </p>

  <noscript>
    <style>#api-explorer-loading { display: none; }</style>
    <p>
      The interactive explorer requires JavaScript. The raw spec is at
      <a href="/openapi.json"><code>/openapi.json</code></a>.
    </p>
  </noscript>

  <p id="api-explorer-loading">Loading API Explorer...</p>

  <div id="scalar-api-reference" style="margin-top: 2rem; min-height: 80vh;"></div>

  <script>
    // Bundled from the installed @scalar/api-reference so the explorer ships
    // with the site instead of running third-party script from a CDN.
    import { createApiReference } from '@scalar/api-reference';
    import '@scalar/api-reference/style.css';

    // Scalar hydrates instead of mounting when its target has children, so the
    // placeholder sits outside the mount point and goes just before mounting.
    document.getElementById('api-explorer-loading')?.remove();

    createApiReference('#scalar-api-reference', {
      url: '/openapi.json',
      darkMode: true,
      servers: [{ url: 'http://127.0.0.1:42829', description: 'Local mxr daemon' }],
      // Scalar otherwise pulls webfonts from fonts.scalar.com and calls
      // api.scalar.com for its chat agent. Neither belongs on these docs.
      withDefaultFonts: false,
      agent: { disabled: true },
    });
  </script>
</StarlightPage>
