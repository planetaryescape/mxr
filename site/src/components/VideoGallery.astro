    provenance: 'Excerpt from a recorded synthetic-inbox agent session. GPT-5.5 is visible; date and mxr version are not identified.',
    steps: [
      'The agent searches inbox mail and asks mxr for JSON output.',
      'A jq expression selects message details for the suspicious-sender review.',
      'The capture shows shell composition; it does not measure time saved or model accuracy.',
    ],
  },
  {
    id: '04-agent-answers-read-only',
    title: 'Review a read-only agent answer',
    duration: '20s',
    description: 'The agent reads synthetic messages, inspects headers, and gives a suspicious-sender summary without changing mail.',
    provenance: 'Excerpt from a recorded synthetic-inbox agent session. GPT-5.5 is visible; date and mxr version are not identified.',
    steps: [
      'The agent searches matching inbox messages and fetches selected headers.',
      'It summarizes the possible scam messages and advises verifying shipping notices independently.',
      'The closing text says it checked read-only and changed nothing; this is a recorded answer, not a live model evaluation.',
    ],
  },
  {
    id: '05-cli-searches-50000-messages',
    title: 'Search a 50,000-message synthetic mailbox',
    duration: '16s',
    description: 'A CLI search for contract-renewal mail displays 50 results from 97 matches in the synthetic dataset.',
    provenance: 'Recorded CLI capture against a synthetic 50,000-message dataset. The clip shows one result page, not a search benchmark.',
    steps: [
      'The command searches for contract-renewal messages.',
      'The terminal reports 50 results on this page and 97 total matches.',
      'No timing comparison or performance measurement is shown.',
    ],
  },
  {
    id: '06-cli-pipes-mail-through-jq',
    title: 'Combine mail search with jq and subscription ranking',
    duration: '21s',
    description: 'The shell capture pipes search JSON through jq, then runs the CLI subscription-ranking command.',
    provenance: 'Recorded CLI capture against synthetic mail. The displayed open-rate label is a local READ-state proxy, not tracked opens.',
    steps: [
      'The command searches newsletter and digest messages and pipes JSON fields through jq.',
      'A second command lists subscription candidates in rank order.',
      'The displayed rate is based on current READ flags and applies only to candidates returned for ranking.',
    ],
  },
  {
    id: '07-cli-ranks-newsletters',
    title: 'Rank returned subscription candidates by read state',
    duration: '17s',
    description: 'The CLI ranks a limited set of subscription candidates using the share of messages currently marked READ.',
    provenance: 'Recorded CLI capture against synthetic mail. Its on-screen “open-rate” wording is a legacy label for current READ state, not distinct message opens.',
    steps: [
      'A search first returns newsletter and digest candidates from the synthetic mailbox.',
      'The subscription command ranks only the candidate set it receives, with a limit shown in the command.',
      'The numerator is the current local READ flag; mxr does not track whether a person opened a message.',
    ],
  },
  {
    id: '08-tui-searches-local-mail',
    title: 'Search local mail in an older TUI layout',
    duration: '13s',
    description: 'This historical TUI capture searches a synthetic 50,000-message mailbox and opens a matching thread.',
    provenance: 'Recorded synthetic-mail TUI capture. The panels and navigation are from an older interface and do not show the current default navigation.',
    steps: [
      'The search view loads results for a query across the local mailbox.',
      'The recording shows a matching result selected beside its message content.',
      'The screen is a historical layout, not a guide to the current default navigation.',
    ],
  },
  {
    id: '09-tui-mail-tools',
    title: 'Inspect a rule in an older TUI workspace',
    duration: '14s',
    description: 'A historical TUI capture opens the Rules workspace and shows the overview for a demo newsletter rule.',
