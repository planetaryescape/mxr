Output site/public/mxr-tui.webm

Require mxr

Set Shell "zsh"
Set FontFamily "JetBrains Mono"
Set FontSize 22
Set Width 1440
Set Height 900
Set Padding 16
Set Framerate 30
Set TypingSpeed 35ms
Set Theme "Catppuccin Mocha"

Hide
Type "mxr" Enter
Sleep 2s
Escape
Sleep 20s
Show
Sleep 1s

Type "/"
Sleep 350ms
Type "flight"
Sleep 300ms
Enter
Sleep 2s

Down 2
Enter
Sleep 2s
Escape

Type "3"
Sleep 2s
Type "4"
Sleep 2s
Type "1"
Sleep 2s

Ctrl+C
